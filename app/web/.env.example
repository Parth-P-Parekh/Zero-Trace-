# Console access.
#
# In development these three default to a shipped demo credential and the login
# page says so on screen. In production nothing is defaulted: if any of them is
# missing, sign-in is refused rather than falling back to a password that ships
# in a public repository.
#
# Copy to .env.local and change the values before this runs anywhere real.

ZT_ADMIN_ID=admin
ZT_ADMIN_PASSWORD=change-me
# Any long random string. Rotating it signs every existing session out.
ZT_SESSION_SECRET=change-me-too
