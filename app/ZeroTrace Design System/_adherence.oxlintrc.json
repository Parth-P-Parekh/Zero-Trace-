        "selector": "JSXOpeningElement[name.name='RedactionMask'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|length|type|revealed|animate|tone|style|key|ref|className|style|children)$/]",
        "message": "<RedactionMask> doesn't accept that prop. Declared props: children, length, type, revealed, animate, tone, style."
