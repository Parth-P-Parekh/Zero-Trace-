        "selector": "JSXOpeningElement[name.name='Metric'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Metric> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayloadView'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|method|path|model|lines|status|latency|scanning|onCopy|style|key|ref|className|style|children)$/]",
        "message": "<PayloadView> doesn't accept that prop. Declared props: id, method, path, model, lines, status, latency, scanning, onCopy, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayloadView'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:clean|redacted|blocked|info|idle)$/]",
        "message": "<PayloadView> status must be one of 'clean' | 'redacted' | 'blocked' | 'info' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|checked|name|value|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, hint, checked, name, value, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|count|active|onClick|onDark|style|key|ref|className|style|children)$/]",
        "message": "<RailItem> doesn't accept that prop. Declared props: icon, label, count, active, onClick, onDark, style."
