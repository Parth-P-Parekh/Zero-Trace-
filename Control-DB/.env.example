# ZeroTrace Part A — every variable the system reads.
# config.py fails loudly at startup on a missing required variable.
# It never silently defaults a security setting.
#
# Copy to .env before `make dev`.

# --- core ---
ZT_ENV=dev                          # dev | demo | prod
ZT_LOG_LEVEL=info
ZT_DEFAULT_TENANT=acme-tech         # dev-only fallback; demo/prod require X-ZeroTrace-Tenant

# --- datastores ---
# Postgres 16 is the datastore (CODE-01 §1). SQLite is accepted by config for the
# local test path only; see SUBMISSION.md "Declared deviations".
ZT_PG_DSN=postgresql+asyncpg://zt:zt@postgres:5432/zerotrace
ZT_REDIS_URL=redis://redis:6379/0

# --- identity (C22) ---
# Part A seeds users and groups. OIDC/SCIM sync arrives at M8 (SKEL-01 §1.1).
ZT_OIDC_ISSUER=http://oidc-stub:9000
ZT_OIDC_CLIENT_ID=zerotrace
ZT_OIDC_CLIENT_SECRET=dev-not-a-secret
ZT_DEV_TOKEN_PREFIX=dev:            # "Authorization: Bearer dev:<idp_subject>"

# --- budgets (ms) — enforced, not aspirational ---
ZT_BUDGET_S4_MS=2                   # one policy decision

# --- upstream (Part A has no real upstream; M5 wires the real one) ---
ZT_UPSTREAM=stub                    # stub | passthrough
ZT_UPSTREAM_BASE_URL=               # required when ZT_UPSTREAM=passthrough
ZT_UPSTREAM_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Not read by Part A. Present so the file stays complete (CODE-01 §3.2).
# ---------------------------------------------------------------------------
ZT_HIVE_BASE_URL=TODO
ZT_HIVE_API_KEY=TODO
ZT_HIVE_MODEL=TODO
ZT_VAULT_MASTER_KEY=TODO
ZT_TOKEN_TTL_S=86400
ZT_TOKEN_SCOPE=session
ZT_SCIM_TOKEN=TODO
ZT_BUDGET_S0_MS=3
ZT_BUDGET_S1_MS=8
ZT_BUDGET_S2_MS=25
ZT_BUDGET_S3_MS=10
ZT_BUDGET_S5_MS=5
ZT_BUDGET_S6_MS=8
ZT_STREAM_WINDOW_CHARS=64
ZT_ESCALATION_BAND_LO=0.35
ZT_ESCALATION_BAND_HI=0.75
ZT_SHADOW_SAMPLE_RATE=0.15
ZT_MAX_PROMOTIONS_PER_HOUR=6
ZT_PROMOTION_MODE=auto
ZT_RAZORPAY_KEY_ID=TODO
ZT_RAZORPAY_KEY_SECRET=TODO
ZT_RAZORPAY_WEBHOOK_SECRET=TODO
